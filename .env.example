# Copy this file to .env, then change the values.
# Docker Compose reads .env from the folder of docker-compose.yml.
# A variable that is commented out is not set.

# The image that Compose starts.
# The default is ghcr.io/ezygang/cuhlumn:latest.
# CUHLUMN_IMAGE=ghcr.io/ezygang/cuhlumn:1.0.0

# The port on 127.0.0.1 of the host that goes to the server.
# The default is 8080.
# CUHLUMN_PORT=8080

# The admin token for the API and the console, at least 32 bytes.
# When this variable is not set, the first visitor of the console sets the token.
# When this variable is set, it replaces the token in the database, and the console cannot change it.
# Make a token with: openssl rand -hex 32
# CUHLUMN_TOKEN=

# The only domain that serves the management console.
# When this variable is not set, the console setting in the database applies.
# When no domain is set, every domain that is not a blog domain serves the console.
# CUHLUMN_CONSOLE_HOST=console.example.com

# The scheme of public URLs: https or http.
# When this variable is not set, the console setting in the database applies.
# The default is https.
# CUHLUMN_SCHEME=https

# The address of a second listener in the container for the console and the admin API.
# When this variable is set, port 8080 serves only the blogs and /api/health.
# The console host setting then has no effect.
# The admin port works without HTTPS, which is acceptable on a private network that encrypts traffic, such as NetBird.
# Otherwise, put a TLS proxy that sets X-Forwarded-Proto: https in front of it.
# CUHLUMN_ADMIN_ADDR=0.0.0.0:8081

# The host address that publishes the admin port, for example the NetBird address of the server.
# The default is 127.0.0.1:8081, so only the server itself can reach the admin port.
# CUHLUMN_ADMIN_PUBLISH=100.92.3.4:8081

# The log filter of the server, for example info or cuhlumn_server=debug.
# RUST_LOG=info

# The token of a Cloudflare tunnel, for the tunnel profile only.
# In the Cloudflare dashboard, send the tunnel traffic to http://cuhlumn:8080.
# Point the tunnel only at the public port 8080, never at the admin port 8081.
# CLOUDFLARE_TUNNEL_TOKEN=
