{
  "name": "@cuhlumn/console",
  "version": "0.15.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings src vite.config.ts",
    "type-check": "tsc --noEmit",
    "validate": "pnpm run lint && pnpm run type-check",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "fix": "oxlint --fix --deny-warnings src vite.config.ts && pnpm run format && pnpm run type-check"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@preact/signals": "^2.11.2",
    "lucide-preact": "^0.468.0",
    "preact": "10.29.8",
    "wouter-preact": "^3.7.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.6",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}
